# 이 파일을 .env 로 복사한 뒤 값을 채워 넣으세요.

# Claude API 키 (console.anthropic.com 에서 발급 — AI 모드 동작에 필요)
ANTHROPIC_API_KEY=

# 관리자 계정 (자리표시 값 그대로면 로그인이 차단됩니다 — 반드시 변경)
ADMIN_ID=admin
ADMIN_PASSWORD=바꿔주세요

# ── 외부 운영 설정
# 이용자 접근 코드: 설정하면 접속자가 코드를 입력해야 사용 가능(외부 공개 시 권장). 비우면 제한 없음.
ACCESS_CODE=
# HTTPS로 운영하는 정식 서버에서는 1 (쿠키를 HTTPS 전용으로 보호). 로컬(http)에서는 0.
COOKIE_SECURE=0

# ── 국내 문헌 검증 API (선택 — 설정하면 국내 문헌 실존 검증이 활성화됩니다)
# KCI 학술지 논문 검증: https://www.kci.go.kr → 오픈API 신청
KCI_API_KEY=
# 국립중앙도서관 단행본(ISBN 서지) 검증: https://www.nl.go.kr/seoji → 인증키 신청
NLK_CERT_KEY=
# 국회도서관 학위논문 등 검증: https://www.data.go.kr → 국회도서관 검색 API 활용신청
NANET_API_KEY=
